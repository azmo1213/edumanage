rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'oquvchi';
    }
    
    function isStudent() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'talaba';
    }
    
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /attendance/{document=**} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isTeacher();
      allow update, delete: if isAdmin();
    }
    
    match /grades/{document=**} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) || isTeacher() || isAdmin();
      allow create, update, delete: if isTeacher() || isAdmin();
    }
    
    match /contracts/{document=**} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /payments/{document=**} {
      allow read: if (isStudent() && resource.data.studentId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /courses/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if isTeacher() || isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
