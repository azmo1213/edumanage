{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".*",
      "functions",
      "seed.js",
      "generate.html"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
